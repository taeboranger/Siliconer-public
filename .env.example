NODE_ENV=development
SILICONER_BASE_URL=http://localhost:3000
SILICONER_HOST=127.0.0.1
SILICONER_PORT=4100
# Production requires PostgreSQL. PGlite is allowed only for local development/tests.
SILICONER_DATABASE_URL=postgresql://siliconer:CHANGE_ME@localhost:55432/siliconer
SILICONER_CONFIG_FILE=./config/integrations.json
SILICONER_LLM_ENABLED=false
# openai: Responses API key; codex: official SDK with ChatGPT subscription login.
SILICONER_LLM_PROVIDER=openai
# Set to an actual model supported by the signed-in account when enabling LLM.
# SILICONER_LLM_MODEL=gpt-6.1-sol
SILICONER_CODEX_HOME=/var/lib/siliconer-codex
SILICONER_LLM_DAILY_CALLS=50
SILICONER_CODEX_TIMEOUT_SECONDS=300
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_DAILY_BUDGET_USD=1
OPENAI_MAX_OUTPUT_TOKENS=2000
SILICONER_NOTIFICATION_URL=
# Required only for the CLI admin bootstrap; never provided to the Web container.
SILICONER_ADMIN_EMAIL=
SILICONER_ADMIN_PASSWORD=
